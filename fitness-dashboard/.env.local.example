# ── Windsor.ai ──────────────────────────────────────────────────────────────
# Your Windsor.ai API key (Dashboard → Settings → API)
WINDSOR_API_KEY=your_windsor_api_key_here

# ── OnceHub ──────────────────────────────────────────────────────────────────
# Your OnceHub API key (Account Settings → API)
ONCEHUB_API_KEY=your_oncehub_api_key_here

# Comma-separated OnceHub booking page IDs per location (preferred over label matching)
# Leave blank to fall back to label-based matching using the location names below
ONCEHUB_RD_PAGE_IDS=
ONCEHUB_SP_PAGE_IDS=

# ── GoHighLevel / location names ─────────────────────────────────────────────
# Must match exactly: GHL sub-account names AND OnceHub booking page labels
GHL_RD_LOCATION=Red Deer
GHL_SP_LOCATION=Sherwood Park
