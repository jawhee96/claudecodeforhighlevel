# ── Mindbody ─────────────────────────────────────────────────────────────────
MINDBODY_API_KEY=your_mindbody_api_key
MINDBODY_SITE_ID=-99          # numeric site ID (negative for sandbox)
MINDBODY_STAFF_USERNAME=your_staff_username
MINDBODY_STAFF_PASSWORD=your_staff_password
MINDBODY_WEBHOOK_SECRET=your_mindbody_webhook_secret

# ── HighLevel (GoHighLevel) ───────────────────────────────────────────────────
HIGHLEVEL_API_KEY=your_highlevel_private_api_key
HIGHLEVEL_LOCATION_ID=your_location_id
HIGHLEVEL_PIPELINE_ID=your_main_pipeline_id
HIGHLEVEL_WEBHOOK_SECRET=your_highlevel_webhook_secret

# ── Oncehub (ScheduleOnce) ────────────────────────────────────────────────────
ONCEHUB_API_KEY=your_oncehub_api_key
ONCEHUB_WEBHOOK_SECRET=your_oncehub_webhook_signing_secret

# ── Trainerize ────────────────────────────────────────────────────────────────
TRAINERIZE_API_KEY=your_trainerize_api_key
TRAINERIZE_WEBHOOK_SECRET=your_trainerize_webhook_secret

# ── App ───────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate_a_random_secret_here
# Set to "true" to skip webhook signature verification during local dev
SKIP_WEBHOOK_VERIFICATION=false
